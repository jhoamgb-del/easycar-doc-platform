{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/signature/create.js": {
      "maxDuration": 30
    },
    "api/signature/webhook.js": {
      "maxDuration": 60
    },
    "api/signature/notify-physical.js": {
      "maxDuration": 30
    },
    "api/reminders/overdue-review.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/reminders/overdue-review",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
